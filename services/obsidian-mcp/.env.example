# Local development env. Copy to .env.local (gitignored) and fill in.
# Used by scripts/obsidian-mcp/test-local.sh — NEVER baked into the
# Docker image (env values come from Secret Manager in Cloud Run).

# CouchDB connection — point at the Phase 1 vault hostname or a tunneled
# port-forward to the e2-micro.
COUCHDB_URL=https://vault.example.studio
COUCHDB_DB=obsidian
COUCHDB_USER=obsidian-mcp
COUCHDB_PASSWORD=

# LiveSync E2EE passphrase — same value you typed into Obsidian's LiveSync
# plugin. Without this, all reads return ciphertext.
LIVESYNC_PASSPHRASE=

# Bearer token clients send in the Authorization header.
MCP_BEARER_TOKEN=

# Auth provider config. Locally you'll probably set AUTH_PROVIDER=disabled
# to skip the Cloudflare Access JWT check (the bearer check still runs).
AUTH_PROVIDER=disabled
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

MCP_HOSTNAME=localhost:8080
LOG_LEVEL=debug
PORT=8080
