# Local development env. Copy to .env.local (gitignored) and fill in.
# Used by scripts/obsidian-mcp/test-local.sh — NEVER baked into the
# Docker image (env values come from Secret Manager in Cloud Run).

# CouchDB connection — point at the Phase 1 vault hostname or a tunneled
# port-forward to the e2-micro.
COUCHDB_URL=https://vault.example.studio
COUCHDB_DB=obsidian
COUCHDB_USER=obsidian-mcp
COUCHDB_PASSWORD=

# LiveSync E2EE passphrase — same value you typed into Obsidian's LiveSync
# plugin. Without this, all reads return ciphertext.
LIVESYNC_PASSPHRASE=

# OAuth signing key — RSA-2048 PKCS#8 PEM. Generate one for local dev with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# This is NOT the production key. Production loads the real key from
# Secret Manager via the OAUTH_SIGNING_KEY env var on Cloud Run.
# Multi-line PEM works in .env if you replace newlines with literal \n
# (dotenv-style) — easier: store as a single line with `\n` separators
# OR base64-encode and decode in your shell before sourcing.
OAUTH_SIGNING_KEY=

# OAuth issuer URL. Locally, http://localhost:8080. In prod, https://mcp.<domain>.
OAUTH_ISSUER=http://localhost:8080

# OAuth token TTLs (seconds). Defaults are sensible; tweak for testing.
# OAUTH_ACCESS_TOKEN_TTL_S=3600
# OAUTH_REFRESH_TOKEN_TTL_S=2592000
# OAUTH_AUTHORIZATION_CODE_TTL_S=60
# OAUTH_GOOGLE_STATE_TTL_S=600

# Google OAuth 2.0 Web application client. Create one in GCP Console →
# APIs & Services → Credentials. For local dev, set the redirect URI to
# http://localhost:8080/oauth/google/callback in the Google client config.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Comma-separated email allow-list. Anyone whose Google account email
# matches one of these can sign in. For local dev, just your own email.
ALLOWED_EMAILS=you@example.com

# ─── vault-indexer (Phase 3) ────────────────────────────────────────────────
# URL the MCP server uses to reach the on-VM vault-indexer for the
# semantic arm of hybrid search. In production this is the tunnel
# hostname (https://indexer.<domain>); locally it can be
# http://localhost:8081 if you're running the indexer on the same host.
INDEXER_URL=
# Shared bearer token. Same value the indexer reads as SEARCH_BEARER_TOKEN.
INDEXER_BEARER_TOKEN=
# Cloudflare Access service-token credentials. Both required together
# when reaching the indexer through the public tunnel; both blank for local dev.
INDEXER_CF_ACCESS_CLIENT_ID=
INDEXER_CF_ACCESS_CLIENT_SECRET=
# How long to wait on /search before giving up and falling back to lexical-only.
INDEXER_TIMEOUT_MS=3000

# ─── Phase 4: meeting transcription ─────────────────────────────────────────
# Recall.ai API key + the Svix webhook signing secret (whsec_...). Point the
# Recall webhook destination at https://mcp.<domain>/recall/webhook.
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
# Optional overrides (sensible defaults live in code):
# RECALL_API_BASE=https://us-east-1.recall.ai
# RECALL_BOT_NAME=Niranjan's AI Assistant
# Bot broadcasts the Sutra logo tile as its webcam by default; set false to disable.
# RECALL_BOT_IMAGE_ENABLED=true
# MEETING_TRANSCRIPTS_FOLDER=Meetings
# participant_events powers the speaker timeline that maps diarized turns to names.
# RECALL_RECORDING_CONFIG_JSON={"audio_mixed_mp3":{},"participant_events":{},"retention":{"type":"timed","hours":2}}

# transcription-service URL + app bearer (sent in the X-Transcription-Token
# header). For local dev, run the transcription-service on another port and
# set USE_ID_TOKEN=false (there is no Cloud Run IAM in front locally).
TRANSCRIPTION_URL=http://localhost:8090
TRANSCRIPTION_BEARER_TOKEN=
TRANSCRIPTION_USE_ID_TOKEN=false

# ─── Phase 5: Google Meet transcript ingestion + digest ─────────────────────
# Everything off by default. See docs/obsidian-mcp/meet-ingestion.md for the
# full setup (Pub/Sub topic, push subscription, per-account refresh tokens).
MEET_INGEST_ENABLED=false
# Expected `aud` of the Pub/Sub push OIDC token — the webhook URL.
# MEET_PUSH_AUDIENCE=https://mcp.<domain>/meet/webhook
# Service account the push subscription signs tokens as.
# MEET_PUSH_SERVICE_ACCOUNT=meet-push@<project>.iam.gserviceaccount.com
# The Google accounts to ingest (personal + work both land in the one
# vault): a JSON array of { name, refreshToken, targetResource }. Mint one
# entry per account (signed in as that account) with:
#   node scripts/obsidian-mcp/get-google-refresh-token.mjs --name work
# MEET_ACCOUNTS_JSON=[{"name":"personal","refreshToken":"1//...","targetResource":"//cloudidentity.googleapis.com/users/<gaia-id>"}]
# Topic Google publishes Meet events to (all accounts share it).
# MEET_PUBSUB_TOPIC=projects/<project>/topics/meet-events
# MEET_TIMEOUT_MS=15000

# Anthropic API key for the transcript digest (todos + person dossiers).
# Empty = digestion disabled; transcripts still ingest.
# ANTHROPIC_API_KEY=
# DIGEST_MODEL=claude-opus-4-8
# DIGEST_SELF_NAME=Niranjan
# DIGEST_TODO_NOTE_PATH=TODO.md
# DIGEST_PEOPLE_FOLDER=People
# DIGEST_TIMEOUT_MS=300000

LOG_LEVEL=debug
PORT=8080
