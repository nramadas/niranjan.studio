# Local development env. Copy to .env.local (gitignored) and fill in.
# Used by scripts/obsidian-mcp/test-local.sh — NEVER baked into the
# Docker image (env values come from Secret Manager in Cloud Run).

# CouchDB connection — point at the Phase 1 vault hostname or a tunneled
# port-forward to the e2-micro.
COUCHDB_URL=https://vault.example.studio
COUCHDB_DB=obsidian
COUCHDB_USER=obsidian-mcp
COUCHDB_PASSWORD=

# LiveSync E2EE passphrase — same value you typed into Obsidian's LiveSync
# plugin. Without this, all reads return ciphertext.
LIVESYNC_PASSPHRASE=

# OAuth signing key — RSA-2048 PKCS#8 PEM. Generate one for local dev with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# This is NOT the production key. Production loads the real key from
# Secret Manager via the OAUTH_SIGNING_KEY env var on Cloud Run.
# Multi-line PEM works in .env if you replace newlines with literal \n
# (dotenv-style) — easier: store as a single line with `\n` separators
# OR base64-encode and decode in your shell before sourcing.
OAUTH_SIGNING_KEY=

# OAuth issuer URL. Locally, http://localhost:8080. In prod, https://mcp.<domain>.
OAUTH_ISSUER=http://localhost:8080

# OAuth token TTLs (seconds). Defaults are sensible; tweak for testing.
# OAUTH_ACCESS_TOKEN_TTL_S=3600
# OAUTH_REFRESH_TOKEN_TTL_S=2592000
# OAUTH_AUTHORIZATION_CODE_TTL_S=60
# OAUTH_GOOGLE_STATE_TTL_S=600

# Google OAuth 2.0 Web application client. Create one in GCP Console →
# APIs & Services → Credentials. For local dev, set the redirect URI to
# http://localhost:8080/oauth/google/callback in the Google client config.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Comma-separated email allow-list. Anyone whose Google account email
# matches one of these can sign in. For local dev, just your own email.
ALLOWED_EMAILS=you@example.com

LOG_LEVEL=debug
PORT=8080
