# Local development env for the transcription-service. Copy to .env.local
# (gitignored) and fill in. NEVER baked into the Docker image — in
# production the values are injected as Cloud Run env from Secret Manager
# by scripts/transcription-service/deploy.sh.

# ─── Speech-to-text backend ─────────────────────────────────────────────────
# Which backend the Transcriber tag resolves to:
#   deepgram — cloud STT (default, the only one implemented today)
#   local    — on-VM model (future; selecting it today fails fast at boot)
TRANSCRIBER=deepgram

# Deepgram API key. Required when TRANSCRIBER=deepgram. This is the single
# credential whose holder sees plaintext meeting audio downstream of the bot.
DEEPGRAM_API_KEY=

# Deepgram model. nova-3 is the current flagship pre-recorded model.
DEEPGRAM_MODEL=nova-3

# ─── HTTP server ────────────────────────────────────────────────────────────
# Cloud Run injects PORT=8080; keep the default aligned.
PORT=8080
BIND_ADDR=0.0.0.0

# App-layer bearer the obsidian-mcp server presents on every /transcribe
# call, behind Cloud Run IAM. The MCP fetches the same value from Secret
# Manager (transcription-service-bearer) and sends it as TRANSCRIPTION_BEARER_TOKEN.
AUTH_BEARER_TOKEN=

LOG_LEVEL=info
