# Local development env. Copy to .env.local (gitignored) and fill in.
# NEVER baked into the Docker image — env values come from /opt/vault-indexer/.env
# on the production VM, populated by scripts/vault-indexer/deploy.sh from
# Secret Manager.

# ─── CouchDB connection ─────────────────────────────────────────────────────
# In production the indexer reaches CouchDB over the compose network as
# `http://couchdb:5984` (no Cloudflare tunnel in this path — the indexer
# is on the same host as CouchDB). For local dev against the prod vault
# use https://vault.<domain>.
COUCHDB_URL=http://couchdb:5984
COUCHDB_DB=obsidian
COUCHDB_USER=obsidian-mcp
COUCHDB_PASSWORD=

# LiveSync E2EE passphrase — same value as the obsidian-mcp service.
LIVESYNC_PASSPHRASE=

# ─── Embedder ───────────────────────────────────────────────────────────────
# bge-small is the default. openai-small/openai-large require OPENAI_API_KEY
# and are intended for evaluation runs, not the production indexer.
EMBEDDER=bge-small
# OPENAI_API_KEY=

# Path where the bge-small ONNX model + tokeniser were baked at image build
# time. Override only if you mounted the model from a different location.
MODEL_DIR=/opt/vault-indexer/model

# ─── Vector store ───────────────────────────────────────────────────────────
SQLITE_PATH=/var/lib/vault-indexer/vectors.db

# ─── Chunking (token estimates, tune-able) ──────────────────────────────────
# Target chunk size in tokens (~4 chars per token in English). The lower
# bound prevents emitting tiny chunks for one-line notes.
CHUNK_TOKEN_TARGET=384
CHUNK_TOKEN_OVERLAP=50
CHUNK_TOKEN_MIN=64

# ─── Changes-feed debouncing ────────────────────────────────────────────────
# How long to wait after the most recent change event for a given doc id
# before re-indexing it, so a burst of saves collapses into one embed.
CHANGES_DEBOUNCE_MS=2000

# ─── HTTP server ────────────────────────────────────────────────────────────
PORT=8081
BIND_ADDR=0.0.0.0
# Shared secret between the MCP server and the indexer. The MCP server
# fetches the same value from Secret Manager (vault-indexer-search-token).
SEARCH_BEARER_TOKEN=

LOG_LEVEL=info
