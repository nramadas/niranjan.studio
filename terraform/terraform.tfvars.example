# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# ─── GCP ────────────────────────────────────────────────────────────────────
gcp_project_id = "your-gcp-project-id"

# Free-tier-eligible regions only: us-east1, us-west1, us-central1.
# Zone gotcha: us-east1 has no "-a" — its zones are b/c/d. us-west1: a/b/c.
# us-central1: a/b/c/f. The variables file enforces this at plan time.
gcp_region = "us-east1"
gcp_zone   = "us-east1-b"

# ─── Cloudflare ─────────────────────────────────────────────────────────────
domain = "example.studio"

# Final hostname becomes <vault_subdomain>.<domain>, e.g. vault.example.studio.
vault_subdomain = "vault"

# Create at https://dash.cloudflare.com/profile/api-tokens with:
#   - Permissions: Zone → Zone:Read, Zone → DNS:Edit
#   - Zone Resources: Include → Specific zone → <your domain>
cloudflare_api_token = "REDACTED"

# Leave empty on the FIRST `terraform apply` — the DNS record is skipped
# until this is set. After running setup-tunnel.sh on the VM, paste the
# tunnel UUID here and re-apply.
cloudflare_tunnel_id = ""

# ─── Obsidian (defaults are usually fine) ───────────────────────────────────
# instance_name        = "obsidian-sync"
# obsidian_db_name     = "obsidian"
# obsidian_admin_user  = "obsidian"

# ─── Obsidian MCP server (Phase 2) ──────────────────────────────────────────
# Final hostname becomes <mcp_subdomain>.<domain>, e.g. mcp.example.studio.
# mcp_subdomain             = "mcp"

# Username the MCP server uses against CouchDB. A scoped account with RW on
# the obsidian DB only — distinct from the admin user, provisioned by
# scripts/obsidian-mcp/create-couchdb-user.sh.
# obsidian_mcp_couchdb_user = "obsidian-mcp"

# Cloudflare Access team domain. Find it at
# https://one.dash.cloudflare.com → Settings → Custom Pages → Team domain.
# Looks like `your-team.cloudflareaccess.com` (no scheme, no path).
cloudflare_access_team_domain = ""

# Cloudflare Access application AUD tag for the MCP application. Cloudflare
# generates this when you create the Access app in the Zero Trust dashboard
# (Access → Applications → your app → Overview → "Application Audience (AUD) Tag").
# Leave empty until you've created the Access application in step 5 of
# docs/obsidian-mcp/setup.md, then re-apply.
cloudflare_access_aud = ""
