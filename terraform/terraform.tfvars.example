# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# ─── GCP ────────────────────────────────────────────────────────────────────
gcp_project_id = "your-gcp-project-id"

# Free-tier-eligible regions only: us-east1, us-west1, us-central1.
# Zone gotcha: us-east1 has no "-a" — its zones are b/c/d. us-west1: a/b/c.
# us-central1: a/b/c/f. The variables file enforces this at plan time.
gcp_region = "us-east1"
gcp_zone   = "us-east1-b"

# ─── Cloudflare (vault tunnel only) ─────────────────────────────────────────
# Cloudflare is the DNS provider for the apex and is the tunnel for CouchDB
# at vault.<domain>. The MCP service does NOT use Cloudflare — its DNS
# record is DNS-only (proxied=false) and points at Google for Cloud Run
# domain mapping.
domain = "example.studio"

# Final hostname becomes <vault_subdomain>.<domain>, e.g. vault.example.studio.
vault_subdomain = "vault"

# Create at https://dash.cloudflare.com/profile/api-tokens with:
#   - Permissions: Zone → Zone:Read, Zone → DNS:Edit
#   - Zone Resources: Include → Specific zone → <your domain>
cloudflare_api_token = "REDACTED"

# Leave empty on the FIRST `terraform apply` — the vault DNS record is skipped
# until this is set. After running setup-tunnel.sh on the VM, paste the
# tunnel UUID here and re-apply.
cloudflare_tunnel_id = ""

# ─── Obsidian (defaults are usually fine) ───────────────────────────────────
# instance_name        = "obsidian-sync"
# obsidian_db_name     = "obsidian"
# obsidian_admin_user  = "obsidian"

# ─── Obsidian MCP server (Phase 2) ──────────────────────────────────────────
# Final hostname becomes <mcp_subdomain>.<domain>, e.g. mcp.example.studio.
# mcp_subdomain             = "mcp"

# Username the MCP server uses against CouchDB. A scoped account with RW on
# the obsidian DB only — distinct from the admin user, provisioned by
# scripts/obsidian-mcp/create-couchdb-user.sh.
# obsidian_mcp_couchdb_user = "obsidian-mcp"

# Google OAuth 2.0 Web application client_id. Created in:
#   GCP Console → APIs & Services → Credentials → + Create Credentials
#   → OAuth client ID → Web application
# Authorized redirect URI: https://mcp.<domain>/oauth/google/callback
# Looks like 1234567890-abcdef.apps.googleusercontent.com.
google_oauth_client_id = "REPLACE_ME.apps.googleusercontent.com"

# Email allow-list. Anyone whose Google account email matches one of these
# (case-insensitive) can sign in to the MCP service. Leave it tight —
# this is the only gate between Google's billion accounts and your vault.
mcp_allowed_emails = [
  "you@example.com",
]

# ─── Vault indexer (Phase 3) ────────────────────────────────────────────────
# The indexer runs on the existing Phase 1 VM (no new compute) and is
# reachable only over the Cloudflare tunnel at indexer.<domain>, gated by
# Cloudflare Access + a bearer token. Defaults are usually fine.
# indexer_subdomain = "indexer"

# ─── Meeting transcription (Phase 4) ────────────────────────────────────────
# Recall.ai regional API host. Recall keys are region-scoped, so this MUST
# match your Recall account's region (us-east-1, us-west-2, eu-central-1,
# ap-northeast-1) — a mismatch 401/404s on every bot call.
# recall_api_base = "https://us-west-2.recall.ai"

# ─── Google Meet transcript ingestion (Phase 5) ─────────────────────────────
# Master switch for zero-touch Meet transcript ingestion (+ Claude digest).
# Leave false (the default) until the obsidian-mcp-meet-accounts secret
# holds at least one account entry — mint entries per account with
# scripts/obsidian-mcp/get-google-refresh-token.mjs — then flip to true,
# re-apply, and redeploy. Full walkthrough: docs/obsidian-mcp/meet-ingestion.md.
# meet_ingest_enabled = false
